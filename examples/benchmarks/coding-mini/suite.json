{
  "schema_version": "1",
  "suite_id": "agentbox-coding-mini",
  "name": "Coding Mini",
  "description": "Small real-rollout coding benchmark using the same Docker env as training collection.",
  "version": "1.0.0",
  "tasks_path": "tasks",
  "sandbox": {
    "image": "python:3.12-slim-bookworm",
    "workspace_dir": "/workspace",
    "working_dir": "/workspace",
    "env": {},
    "limits": {
      "cpu_count": 1.0,
      "memory_mb": 512,
      "pids_limit": 256,
      "network_disabled": false,
      "memswap_mb": null
    },
    "auto_pull": true,
    "auto_remove": true,
    "keep_on_failure": false,
    "labels": {},
